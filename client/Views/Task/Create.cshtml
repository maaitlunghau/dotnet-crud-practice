@using client.DTOs
@using client.Enums
@model TaskCreateDto

@{
    ViewData["Title"] = "Thêm Công việc mới";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-gradient bg-primary text-white py-3">
                    <h3 class="mb-0 fs-4 fw-bold">
                        <i class="bi bi-plus-circle-fill me-2 text-white"></i>Thêm Công việc mới
                    </h3>
                    <p class="mb-0 small text-light opacity-75">Vui lòng điền thông tin bên dưới để bắt đầu công việc.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control border-0 bg-light rounded-3" 
                                   id="floatingTitle" placeholder="Nhập tiêu đề..." required>
                            <label for="floatingTitle" class="text-muted small">Tiêu đề công việc</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control border-0 bg-light rounded-3" 
                                      id="floatingDesc" placeholder="Mô tả chi tiết..." style="height: 120px;"></textarea>
                            <label for="floatingDesc" class="text-muted small">Mô tả công việc</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<PriorityTask>()" 
                                            class="form-select border-0 bg-light rounded-3" id="floatingPriority">
                                    </select>
                                    <label for="floatingPriority" class="text-muted small">Độ ưu tiên</label>
                                    <span asp-validation-for="Priority" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input asp-for="DueDate" type="date" class="form-control border-0 bg-light rounded-3" 
                                           id="floatingDate">
                                    <label for="floatingDate" class="text-muted small">Hạn chót (tùy chọn)</label>
                                    <span asp-validation-for="DueDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column-reverse flex-sm-row gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg flex-grow-1 border-1 rounded-3">
                                <i class="bi bi-arrow-left me-1"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow-sm rounded-3">
                                <i class="bi bi-check-circle me-1"></i>Lưu công việc
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

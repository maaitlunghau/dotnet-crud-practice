@using client.DTOs
@using client.Enums
@model TaskUpdateDto

@{
    ViewData["Title"] = "Chỉnh sửa Công việc";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden shadow-sm">
                <div class="card-header bg-gradient bg-info text-white py-3">
                    <h3 class="mb-0 fs-4 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa công việc
                    </h3>
                    <p class="mb-0 small text-light opacity-75">Cập nhật thông tin chi tiết cho công việc của bạn.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control border-0 bg-light rounded-3 shadow-none" 
                                   id="floatingTitle" placeholder="Nhập tiêu đề..." required>
                            <label for="floatingTitle" class="text-muted small">Tiêu đề</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control border-0 bg-light rounded-3 shadow-none" 
                                      id="floatingDesc" placeholder="Mô tả..." style="height: 120px;"></textarea>
                            <label for="floatingDesc" class="text-muted small">Mô tả chi tiết</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<PriorityTask>()" 
                                            class="form-select border-0 bg-light rounded-3 shadow-none" id="floatingPriority">
                                    </select>
                                    <label for="floatingPriority" class="text-muted small">Độ ưu tiên</label>
                                    <span asp-validation-for="Priority" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<StatusTask>()" 
                                            class="form-select border-0 bg-light rounded-3 shadow-none" id="floatingStatus">
                                    </select>
                                    <label for="floatingStatus" class="text-muted small">Trạng thái</label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="DueDate" type="date" class="form-control border-0 bg-light rounded-3 shadow-none" 
                                   id="floatingDate">
                            <label for="floatingDate" class="text-muted small">Ngày hết hạn</label>
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-column-reverse flex-sm-row gap-3">
                            <a asp-action="Index" class="btn btn-light btn-lg flex-grow-1 border-1 rounded-3">
                                <i class="bi bi-arrow-left me-1"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-info btn-lg flex-grow-1 shadow-sm text-white rounded-3">
                                <i class="bi bi-save me-1"></i>Cập nhật ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

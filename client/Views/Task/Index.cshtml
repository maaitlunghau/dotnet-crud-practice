@using client.DTOs
@using client.Enums
@model IEnumerable<TaskResponseDto>

@{
    ViewData["Title"] = "Danh sách Công việc";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold"><i class="bi bi-list-task"></i> Quản lý Công việc</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm Công việc mới
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Tiêu đề</th>
                            <th>Mô tả</th>
                            <th>Độ ưu tiên</th>
                            <th>Trạng thái</th>
                            <th>Hạn chót</th>
                            <th class="text-center pe-4" style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@task.Title</td>
                                <td class="text-muted small text-truncate" style="max-width: 200px;">@task.Description</td>
                                <td>
                                    <span class="badge rounded-pill @GetPriorityBadge(task.Priority)">
                                        @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadge(task.Status)">
                                        @task.Status
                                    </span>
                                </td>
                                <td class="small text-secondary">
                                    @task.DueDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@task.Id" method="post" 
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa không?');" 
                                              style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Chưa có công việc nào được thêm vào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetPriorityBadge(PriorityTask priority) => priority switch
    {
        PriorityTask.High => "bg-danger",
        PriorityTask.Medium => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };

    string GetStatusBadge(StatusTask status) => status switch
    {
        StatusTask.Completed => "bg-success",
        StatusTask.InProgress => "bg-primary",
        _ => "bg-secondary"
    };
}
